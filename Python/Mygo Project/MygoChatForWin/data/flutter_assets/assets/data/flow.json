    {
      "id": "ending_2",
      "type": "ending",
      "character": "narrator",
      "speaker": "旁白",
      "text": "虽然少了乐奈的身影有些遗憾，\n但爱音、灯、素世和立希四人决定先开始练习。\n\n「下次一定要把乐奈也拉进来！」\n爱音握紧拳头，眼中闪着光芒。",
      "background": "bg_stage.png",
      "endingId": 2,
      "endingName": "★★ 四人前行 — 爱素灯希 ★★",
      "x": 150,
      "y": 850
    },
    {
      "id": "branch_b_light_silent",
      "type": "dialogue",
      "character": "tomori",
      "speaker": "灯",
      "text": "…………\n（低头玩着手中的石头）",
