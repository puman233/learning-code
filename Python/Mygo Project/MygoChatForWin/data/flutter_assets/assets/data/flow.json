      "next": "branch_b_light_gugu",
      "x": 650,
      "y": 350
    },
    {
      "id": "branch_b_light_gugu",
      "type": "dialogue",
      "character": "tomori",
      "speaker": "灯",
      "text": "咕…咕嘎嘎…\n（发出含糊不清的声音）",
      "background": "bg_livehouse.png",
      "next": "branch_b_light_bandaid",
      "x": 650,
      "y": 450
    },
    {
      "id": "branch_b_light_bandaid",
      "type": "dialogue",
      "character": "tomori",
      "speaker": "灯",
      "text": "…………创可贴…\n（把创可贴贴在吉他上）",
      "background": "bg_livehouse.png",
      "next": "branch_b_taki_angry",
      "x": 650,
      "y": 550
    },
    {
      "id": "branch_b_taki_angry",
      "type": "dialogue",
      "character": "rikki",
      "speaker": "立希",
      "text": "够了！别让灯为难了！\n爱音你没看到灯不想吗？！",
      "background": "bg_livehouse.png",
      "next": "branch_b_soyo_reluctant",
      "x": 650,
      "y": 650
